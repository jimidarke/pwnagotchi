# DarkeHash Server Configuration
# Copy this file to .env and update with your values

# Server Port
PORT=8800

# Authentication - Use either plain password OR password hash (hash is more secure)
AUTH_USERNAME=darkepwn
AUTH_PASSWORD=dh2akf5ksdai44ad0y

# Optional: Use a password hash instead of plain password for better security
# Generate with: python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password'))"
# AUTH_PASSWORD_HASH=

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Storage Settings
SAVE_LOGS_TO_FILE=true

# Debug Mode (set to false in production)
DEBUG=false
